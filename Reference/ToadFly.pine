//@version=6
indicator("財神爺主圖 V17｜台股中長線決策版", overlay = true, max_labels_count = 500, max_lines_count = 500)

//====================================================
// 一、使用者參數
//====================================================
showLabels = input.bool(true, "顯示訊號標籤")
showStatus = input.bool(true, "顯示右上角狀態")
showBox = input.bool(true, "顯示箱型區間")
showChannel = input.bool(true, "顯示布林通道")
showStop = input.bool(true, "顯示防守線")

costInput = input.float(0.0, "庫存成本，沒有可填 0", step = 0.1)

ema5Len = input.int(5, "EMA5", minval = 1)
ema10Len = input.int(10, "EMA10", minval = 1)
ema20Len = input.int(20, "EMA20", minval = 1)
ema60Len = input.int(60, "EMA60", minval = 1)
ema200Len = input.int(200, "EMA200", minval = 1)

boxLen = input.int(40, "箱型觀察天數", minval = 10)
boxNearPct = input.float(8.0, "接近箱底百分比", step = 0.5)
breakoutPct = input.float(1.2, "突破箱頂百分比", step = 0.1)
nearEma20Pct = input.float(5.0, "接近 EMA20 百分比", step = 0.5)
tooFarEma20Pct = input.float(12.0, "過熱距 EMA20 百分比", step = 0.5)

volLen = input.int(20, "成交量均量天數", minval = 5)
volStrongRatio = input.float(1.3, "放量倍數", step = 0.1)

atrLen = input.int(14, "ATR 天數", minval = 5)
riskAtrMult = input.float(2.0, "防守 ATR 倍數", step = 0.1)

cooldownBars = input.int(8, "訊號冷卻天數", minval = 1)
statusShift = input.int(1, "右上角狀態下移格數", minval = 0, maxval = 8)

profitTakePct = input.float(18.0, "庫存獲利達此比例後啟動停利判斷", step = 1.0)
lossCutPct = input.float(-8.0, "庫存虧損達此比例後提高風險警示", step = 1.0)

//====================================================
// 二、基礎指標
//====================================================
ema5 = ta.ema(close, ema5Len)
ema10 = ta.ema(close, ema10Len)
ema20 = ta.ema(close, ema20Len)
ema60 = ta.ema(close, ema60Len)
ema200 = ta.ema(close, ema200Len)

atr = ta.atr(atrLen)
volAvg = ta.sma(volume, volLen)
volRatio = volAvg > 0 ? volume / volAvg : 0.0

boxHigh = ta.highest(high, boxLen)
boxLow = ta.lowest(low, boxLen)
boxRange = boxHigh - boxLow
boxPos = boxRange > 0 ? (close - boxLow) / boxRange : 0.5

basis = ta.sma(close, 20)
dev = ta.stdev(close, 20)
bbUpper = basis + dev * 2.0
bbLower = basis - dev * 2.0
bbWidth = basis != 0 ? (bbUpper - bbLower) / basis * 100.0 : 0.0
bbWidthAvg = ta.sma(bbWidth, 60)
isCompress = bbWidthAvg > 0 ? bbWidth < bbWidthAvg * 0.75 : false

ema20Dist = ema20 != 0 ? (close - ema20) / ema20 * 100.0 : 0.0
ema60Dist = ema60 != 0 ? (close - ema60) / ema60 * 100.0 : 0.0

hasCost = costInput > 0
profitPct = hasCost ? (close - costInput) / costInput * 100.0 : na

//====================================================
// 三、趨勢結構
//====================================================
trendBull = ema5 > ema10 and ema10 > ema20 and ema20 > ema60 # 強多頭排列
trendMediumBull = close > ema20 and ema20 > ema60
trendLongBull = close > ema60 and ema60 > ema200 # 長線多頭
trendWeak = close > ema60 and ema20 > close and ema60 > ema20 # 偏弱
trendBear = ema60 > close and ema60 > ema20 # 空頭

priceAboveEma20 = close > ema20
priceNearEma20 = math.abs(ema20Dist) <= nearEma20Pct
priceTooFar = ema20Dist >= tooFarEma20Pct

ema20Rising = ema20 > ema20[1]
ema60Rising = ema60 > ema60[1]

//====================================================
// 四、資金與量能
//====================================================
upVol = close > close[1] ? volume : 0.0 # 上漲日量比較多，偏買方
downVol = close < close[1] ? volume : 0.0 # 下跌日量比較多，偏賣方

moneyRaw = ta.ema(upVol - downVol, 13) # 做 13 日 EMA 平滑，EMAt​=αxt​+(1−α)EMAt−1​
moneySignal = ta.ema(moneyRaw, 10)
moneyBull = moneyRaw > moneySignal and moneyRaw > 0
moneyRecover = moneyRaw > moneySignal and moneyRaw > moneyRaw[1] 
moneyWeak = moneyRaw < moneySignal and moneyRaw < 0

volStrong = volRatio >= volStrongRatio
volDry = volRatio < 0.8

//====================================================
// 五、Delta 強弱
//====================================================
deltaRaw = close - open
deltaPower = ta.ema(deltaRaw, 5)
deltaSignal = ta.ema(deltaPower, 10)

deltaBull = deltaPower > deltaSignal and deltaPower > 0
deltaRecover = deltaPower > deltaSignal and deltaPower > deltaPower[1] 
deltaWeak = deltaPower < deltaSignal and deltaPower < 0

//====================================================
// 六、低位建倉邏輯
//====================================================
nearBoxLow = boxPos <= boxNearPct / 100.0
nearLowerBand = close <= basis and low <= bbLower * 1.03
supportHold = low <= ema20 * 1.03 and close >= ema20 * 0.98
deepSupportHold = low <= ema60 * 1.03 and close >= ema60 * 0.98

lowBaseReady = nearBoxLow or nearLowerBand or supportHold or deepSupportHold
lowMoneyTurn = moneyRecover or moneyBull
lowDeltaTurn = deltaRecover or deltaBull
lowRiskOk = close >= ema60 or close >= boxLow * 1.03

lowTestSignalRaw = lowBaseReady and lowMoneyTurn and lowDeltaTurn and lowRiskOk and not trendBear

//====================================================
// 七、突破試單與加碼邏輯
//====================================================
boxBreak = close > boxHigh[1] * (1.0 + breakoutPct / 100.0)
emaBreak = close > ema20 and close[1] <= ema20[1]
compressBreak = isCompress[1] and close > bbUpper[1] and volStrong

trialSignalRaw = (boxBreak or emaBreak or compressBreak) and moneyBull and deltaBull and close > ema20 and not priceTooFar

pullbackHold = close > ema20 and low <= ema20 * 1.025 and close > open
strongTrendAdd = trendBull and priceNearEma20 and moneyBull and deltaBull and not priceTooFar

addSignalRaw = (pullbackHold or strongTrendAdd) and close > ema20 and ema20Rising and not priceTooFar

//====================================================
// 八、賣出與減碼邏輯
//====================================================
structureStop = math.max(ema60, boxLow)

breakEma20 = close < ema20 and close[1] < ema20[1]
breakEma60 = close < ema60
breakBoxLow = close < boxLow[1]

moneyExit = moneyWeak and deltaWeak
highProfitRisk = hasCost and profitPct >= profitTakePct and close < ema5 and deltaWeak
lossRisk = hasCost and profitPct <= lossCutPct and close < ema20

sellSignalRaw = breakEma60 or breakBoxLow or lossRisk or (breakEma20 and moneyExit)
reduceSignalRaw = highProfitRisk or (priceTooFar and deltaWeak) or (close < ema20 and moneyWeak)

//====================================================
// 九、分數系統
//====================================================
score = 0

score += trendBull ? 25 : trendMediumBull ? 18 : trendLongBull ? 12 : trendWeak ? -15 : 0
score += priceNearEma20 ? 12 : priceTooFar ? -18 : priceAboveEma20 ? 8 : -8
score += moneyBull ? 18 : moneyRecover ? 10 : moneyWeak ? -15 : 0
score += deltaBull ? 15 : deltaRecover ? 8 : deltaWeak ? -12 : 0
score += volStrong ? 10 : volDry ? -3 : 3
score += lowBaseReady ? 12 : 0
score += trialSignalRaw ? 12 : 0
score += sellSignalRaw ? -35 : reduceSignalRaw ? -18 : 0
score += hasCost and profitPct >= profitTakePct and priceTooFar ? -12 : 0
score += hasCost and profitPct <= lossCutPct ? -20 : 0

scoreClamped = math.max(0, math.min(score, 100))

//====================================================
// 十、最終決策
//====================================================
decisionText = ""

if sellSignalRaw
    decisionText := "賣出"
else if reduceSignalRaw
    decisionText := "減碼"
else if lowTestSignalRaw and scoreClamped >= 60
    decisionText := "低試"
else if trialSignalRaw and scoreClamped >= 70
    decisionText := "試單"
else if addSignalRaw and scoreClamped >= 75
    decisionText := "加碼"
else if trendBull and not reduceSignalRaw and close > ema20
    decisionText := "續抱"
else
    decisionText := "觀察"

//====================================================
// 十一、訊號冷卻
//====================================================
var int lastLowTestBar = na
var int lastTrialBar = na
var int lastAddBar = na
var int lastSellBar = na
var int lastReduceBar = na

canLowTest = na(lastLowTestBar) or bar_index - lastLowTestBar > cooldownBars
canTrial = na(lastTrialBar) or bar_index - lastTrialBar > cooldownBars
canAdd = na(lastAddBar) or bar_index - lastAddBar > cooldownBars
canSell = na(lastSellBar) or bar_index - lastSellBar > cooldownBars
canReduce = na(lastReduceBar) or bar_index - lastReduceBar > cooldownBars

lowTestSignal = lowTestSignalRaw and canLowTest
trialSignal = trialSignalRaw and canTrial
addSignal = addSignalRaw and canAdd
sellSignal = sellSignalRaw and canSell
reduceSignal = reduceSignalRaw and canReduce

if lowTestSignal
    lastLowTestBar := bar_index

if trialSignal
    lastTrialBar := bar_index

if addSignal
    lastAddBar := bar_index

if sellSignal
    lastSellBar := bar_index

if reduceSignal
    lastReduceBar := bar_index

//====================================================
// 十二、狀態文字
//====================================================
trendText = trendBull ? "多頭排列" : trendMediumBull ? "偏多" : trendLongBull ? "中性偏多" : trendWeak ? "偏弱" : "整理"
priceText = priceTooFar ? "過熱" : priceNearEma20 ? "貼近 EMA20" : close > ema20 ? "站上 EMA20" : "跌破 EMA20"
moneyText = moneyBull ? "資金偏多" : moneyRecover ? "資金回升" : moneyWeak ? "資金轉弱" : "資金中性"
deltaText = deltaBull ? "買方主導" : deltaRecover ? "買方回升" : deltaWeak ? "賣方主導" : "普通"
riskText = sellSignalRaw ? "破防守" : reduceSignalRaw ? "需減碼" : priceTooFar ? "不追高" : "正常"

//====================================================
// 十三、畫線
//====================================================
plot(ema5, "EMA5", color = color.rgb(190, 80, 220), linewidth = 1)
plot(ema10, "EMA10", color = color.rgb(0, 145, 160), linewidth = 1)
plot(ema20, "EMA20", color = color.rgb(220, 50, 55), linewidth = 2)
plot(ema60, "EMA60", color = color.rgb(255, 145, 0), linewidth = 2)
plot(ema200, "EMA200", color = color.rgb(120, 120, 120), linewidth = 2)

plot(showChannel ? bbUpper : na, "布林上緣", color = color.rgb(180, 180, 180))
plot(showChannel ? bbLower : na, "布林下緣", color = color.rgb(180, 180, 180))

plot(showBox ? boxHigh : na, "箱型上緣", color = color.rgb(240, 190, 0), linewidth = 1)
plot(showBox ? boxLow : na, "箱型下緣", color = color.rgb(240, 190, 0), linewidth = 1)

plot(showStop ? structureStop : na, "防守線", color = color.rgb(255, 80, 80), linewidth = 1)

//====================================================
// 十四、訊號標籤
//====================================================
if showLabels and lowTestSignal
    label.new(bar_index, low, "低試", style = label.style_label_up, color = color.rgb(0, 125, 80), textcolor = color.white, size = size.small)

if showLabels and trialSignal
    label.new(bar_index, low, "試", style = label.style_label_up, color = color.rgb(0, 105, 170), textcolor = color.white, size = size.small)

if showLabels and addSignal
    label.new(bar_index, low, "加", style = label.style_label_up, color = color.rgb(30, 110, 200), textcolor = color.white, size = size.small)

if showLabels and reduceSignal
    label.new(bar_index, high, "減", style = label.style_label_down, color = color.rgb(230, 140, 0), textcolor = color.white, size = size.small)

if showLabels and sellSignal
    label.new(bar_index, high, "賣", style = label.style_label_down, color = color.rgb(190, 30, 35), textcolor = color.white, size = size.small)

//====================================================
// 十五、右上角狀態表
//====================================================
f_bg(txt) =>
    txt == "賣出" ? color.rgb(180, 30, 35) :
     txt == "減碼" ? color.rgb(230, 120, 0) :
     txt == "低試" ? color.rgb(0, 125, 80) :
     txt == "試單" ? color.rgb(0, 105, 170) :
     txt == "加碼" ? color.rgb(30, 110, 200) :
     txt == "續抱" ? color.rgb(40, 130, 70) :
     txt == "不追高" ? color.rgb(230, 120, 0) :
     txt == "破防守" ? color.rgb(180, 30, 35) :
     txt == "需減碼" ? color.rgb(230, 120, 0) :
     color.rgb(70, 70, 70)

var table t = table.new(position.top_right, 2, 12, border_width = 1)

if showStatus and barstate.islast
    for i = 0 to statusShift - 1
        table.cell(t, 0, i, "", bgcolor = color.new(color.black, 100))
        table.cell(t, 1, i, "", bgcolor = color.new(color.black, 100))

    r = statusShift

    table.cell(t, 0, r, "決策", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r, decisionText, text_color = color.white, bgcolor = f_bg(decisionText))

    table.cell(t, 0, r + 1, "分數", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 1, str.tostring(scoreClamped), text_color = color.white, bgcolor = scoreClamped >= 75 ? color.rgb(40, 130, 70) : scoreClamped >= 60 ? color.rgb(230, 140, 0) : color.rgb(180, 30, 35))

    table.cell(t, 0, r + 2, "趨勢", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 2, trendText, text_color = color.white, bgcolor = trendBull ? color.rgb(40, 130, 70) : trendWeak ? color.rgb(180, 30, 35) : color.rgb(230, 140, 0))

    table.cell(t, 0, r + 3, "價格", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 3, priceText, text_color = color.white, bgcolor = priceTooFar ? color.rgb(230, 120, 0) : priceAboveEma20 ? color.rgb(40, 130, 70) : color.rgb(180, 30, 35))

    table.cell(t, 0, r + 4, "資金", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 4, moneyText, text_color = color.white, bgcolor = moneyBull ? color.rgb(40, 130, 70) : moneyWeak ? color.rgb(230, 120, 0) : color.rgb(70, 70, 70))

    table.cell(t, 0, r + 5, "Delta", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 5, deltaText, text_color = color.white, bgcolor = deltaBull ? color.rgb(40, 130, 70) : deltaWeak ? color.rgb(180, 30, 35) : color.rgb(70, 70, 70))

    table.cell(t, 0, r + 6, "風險", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 6, riskText, text_color = color.white, bgcolor = f_bg(riskText))

    table.cell(t, 0, r + 7, "防守價", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 7, str.tostring(structureStop, format.mintick), text_color = color.white, bgcolor = color.rgb(70, 70, 70))

    table.cell(t, 0, r + 8, "距 EMA20", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 8, str.tostring(ema20Dist, "#.##") + "%", text_color = color.white, bgcolor = priceTooFar ? color.rgb(230, 120, 0) : color.rgb(40, 130, 70))

    table.cell(t, 0, r + 9, "損益", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 9, hasCost ? str.tostring(profitPct, "#.##") + "%" : "未設定", text_color = color.white, bgcolor = hasCost ? profitPct >= 0 ? color.rgb(40, 130, 70) : color.rgb(180, 30, 35) : color.rgb(70, 70, 70))

    table.cell(t, 0, r + 10, "箱位", text_color = color.white, bgcolor = color.rgb(40, 45, 50))
    table.cell(t, 1, r + 10, str.tostring(boxPos * 100.0, "#.##") + "%", text_color = color.white, bgcolor = boxPos <= 0.25 ? color.rgb(0, 125, 80) : boxPos >= 0.8 ? color.rgb(230, 120, 0) : color.rgb(70, 70, 70))

//====================================================
// 十六、警示條件
//====================================================
alertcondition(lowTestSignal, "低位試單", "低位試單訊號出現")
alertcondition(trialSignal, "突破試單", "突破試單訊號出現")
alertcondition(addSignal, "加碼", "加碼訊號出現")
alertcondition(reduceSignal, "減碼", "減碼訊號出現")
alertcondition(sellSignal, "賣出", "賣出訊號出現")